@{
    Layout = "_Layout";
}

<!-- Custom Dark CSS for Dashboard Widgets -->
<style>
    /* Metric Cards */
    .metric-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.15);
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .metric-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.15);
    }

    .metric-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        font-weight: 600;
    }

    .metric-val {
        font-size: 2rem;
        font-weight: 700;
        margin-top: 0.25rem;
    }

    .metric-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Metric Color Themes */
    .m-online .metric-icon { background: rgba(16, 185, 129, 0.1); color: #10b981; }
    .m-online .metric-val { color: #10b981; }

    .m-offline .metric-icon { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .m-offline .metric-val { color: #ef4444; }

    .m-moving .metric-icon { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
    .m-moving .metric-val { color: #3b82f6; }

    .m-low-battery .metric-icon { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .m-low-battery .metric-val { color: #ef4444; }

    /* Dashboard panels */
    .panel-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 1.25rem;
        padding: 1.5rem;
        box-shadow: 0 8px 30px 0 rgba(0, 0, 0, 0.2);
        height: 100%;
    }

    .panel-title {
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Table custom styling */
    .table-responsive {
        overflow-x: auto;
    }

    .table-custom {
        margin-bottom: 0;
        width: 100%;
    }

    .table-custom th {
        color: var(--text-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        padding: 1rem 0.75rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .table-custom td {
        color: #cbd5e1;
        padding: 1rem 0.75rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        vertical-align: middle;
    }

    .table-custom tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.01);
    }

    .row-online {
        background-color: rgba(16, 185, 129, 0.015) !important;
    }
    .row-moving {
        background-color: rgba(59, 130, 246, 0.015) !important;
    }
    .row-offline {
        opacity: 0.55;
    }

    .mac-addr {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        color: #94a3b8;
    }

    .dev-name {
        font-weight: 600;
        color: #ffffff;
    }

    /* Badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.65rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 9999px;
        text-transform: uppercase;
    }

    .badge-on { background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2); }
    .badge-off { background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); }
    .badge-mov { background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2); }
    .badge-idle { background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.2); }

    .rssi-value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
    }

    /* Alerts List */
    .alerts-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .alert-item {
        background: rgba(255, 255, 255, 0.02);
        border-left: 3px solid transparent;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        transition: background 0.2s ease;
    }

    .alert-item:hover {
        background: rgba(255, 255, 255, 0.04);
    }

    .alert-danger-custom { border-left-color: #ef4444; }
    .alert-warning-custom { border-left-color: #f59e0b; }
    .alert-info-custom { border-left-color: #3b82f6; }
    .alert-success-custom { border-left-color: #10b981; }

    .alert-time {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
        display: block;
    }

    .chart-container {
        position: relative;
        height: 220px;
        width: 100%;
    }
</style>

<div class="px-2">
    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 pb-2" style="border-bottom: 1px solid var(--border-color);">
        <div>
            <h2 class="h5 fw-bold text-white mb-0">Dashboard</h2>
        </div>
        <div class="d-flex align-items-center gap-3 text-muted animate-fade" style="font-size: 0.85rem;">
            <div>
                <i class="bi bi-clock"></i> Current Time: <span id="current-time-display" class="text-white fw-semibold">-</span>
            </div>
            <div class="d-none d-md-block">|</div>
            <div>
                <i class="bi bi-arrow-repeat"></i> Last Updated: <span id="last-updated-display" class="text-white fw-semibold">-</span>
            </div>
        </div>
    </div>

    <!-- Position Relative Wrapper for Loading Overlay -->
    <div class="position-relative" style="min-height: 400px;">
        <!-- Loading Overlay -->
        <div id="dashboard-loading-overlay" class="d-flex flex-column align-items-center justify-content-center position-absolute top-0 start-0 w-100 h-100" style="background: var(--main-bg); z-index: 100; transition: opacity 0.3s ease; min-height: 400px;">
            <div class="spinner-border text-primary mb-3" style="width: 2.5rem; height: 2.5rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="text-muted fw-semibold" style="font-size: 0.95rem;">Loading Dashboard...</div>
        </div>

        <!-- Main Dashboard Content -->
        <div id="dashboard-main-content" style="opacity: 0; transition: opacity 0.3s ease;">
            <!-- Summary Grid -->
            <div class="row g-4 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card m-online">
                        <div>
                            <div class="metric-label">Online Devices</div>
                            <div id="count-online" class="metric-val">-</div>
                        </div>
                        <div class="metric-icon">
                            <i class="bi bi-shield-check fs-4"></i>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card m-offline">
                        <div>
                            <div class="metric-label">Offline Devices</div>
                            <div id="count-offline" class="metric-val">-</div>
                        </div>
                        <div class="metric-icon">
                            <i class="bi bi-shield-slash fs-4"></i>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card m-moving">
                        <div>
                            <div class="metric-label">Moving Devices</div>
                            <div id="count-moving" class="metric-val">-</div>
                        </div>
                        <div class="metric-icon">
                            <i class="bi bi-activity fs-4"></i>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card m-low-battery">
                        <div>
                            <div class="metric-label">Low Battery Devices</div>
                            <div id="count-low-battery" class="metric-val">-</div>
                        </div>
                        <div class="metric-icon">
                            <i class="bi bi-battery-alert fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tracked Devices Table Panel -->
            <div class="panel-card mb-4">
                <div class="panel-title mb-3">Tracked Devices</div>
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>MAC Address</th>
                                <th>Device Name</th>
                                <th>Access Point</th>
                                <th>Building</th>
                                <th>Floor</th>
                                <th>Location</th>
                                <th>RSSI</th>
                                <th>Distance</th>
                                <th>Battery</th>
                                <th>Status</th>
                                <th>Last Seen</th>
                            </tr>
                        </thead>
                        <tbody id="devices-tbody">
                            <!-- Loaded dynamically from api -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Charts & Recent Alerts Row -->
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="panel-card">
                        <div class="panel-title mb-3">RSSI Signal (Live Tracking)</div>
                        <div class="chart-container" style="height: 240px;">
                            <canvas id="rssiChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="panel-card d-flex flex-column" style="min-height: 280px;">
                        <div class="panel-title mb-3">Recent Alerts</div>
                        <div class="flex-grow-1 d-flex flex-column justify-content-between">
                            <div id="recent-alerts-container" class="w-100 d-flex flex-column gap-2">
                                <!-- Populated via JS -->
                            </div>
                            <div class="pt-3 border-top mt-3" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                                <a href="/Alerts" class="text-white text-decoration-none fw-semibold" style="font-size: 0.85rem; transition: color 0.2s;" onmouseover="this.style.color='#cbd5e1'" onmouseout="this.style.color='#ffffff'">
                                    View All Alerts &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- SignalR Client Script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <!-- Chart.js Script via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Dashboard Controller Link to Database API -->
    <script>
        // Set Chart.js Defaults for Dark Mode
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.08)';

        // Chart References
        let rssiChart = null;
        let batteryChart = null;
        const rssiHistory = {};
        const timeLabels = [];
        let isFetchingDashboard = false;

        // Helper: Calculate relative time string
        function getRelativeTimeStr(lastSeenStr) {
            if (!lastSeenStr) return 'Never';
            
            // Append Z to parse correctly as UTC date on client side
            const dateStr = lastSeenStr.endsWith('Z') ? lastSeenStr : lastSeenStr + 'Z';
            const lastSeenDate = new Date(dateStr);
            if (isNaN(lastSeenDate.getTime())) return 'Never';
            
            const now = new Date();
            const diffMs = now - lastSeenDate;
            const diffSecs = Math.max(0, Math.floor(diffMs / 1000));
            
            if (diffSecs < 10) {
                return 'just now';
            } else if (diffSecs < 60) {
                return `${diffSecs} sec ago`;
            } else if (diffSecs < 3600) {
                const diffMins = Math.floor(diffSecs / 60);
                return `${diffMins} min ago`;
            } else if (diffSecs < 86400) {
                const diffHrs = Math.floor(diffSecs / 3600);
                return `${diffHrs} hr ago`;
            } else if (diffSecs < 604800) {
                const diffDays = Math.floor(diffSecs / 86400);
                return `${diffDays} days ago`;
            } else {
                // yyyy-MM-dd HH:mm
                const yyyy = lastSeenDate.getFullYear();
                const MM = String(lastSeenDate.getMonth() + 1).padStart(2, '0');
                const dd = String(lastSeenDate.getDate()).padStart(2, '0');
                const HH = String(lastSeenDate.getHours()).padStart(2, '0');
                const mm = String(lastSeenDate.getMinutes()).padStart(2, '0');
                return `${yyyy}-${MM}-${dd} ${HH}:${mm}`;
            }
        }

        // Helper: Map status to badge class
        function getBadgeClass(status) {
            switch (status) {
                case 'Online': return 'badge-on';
                case 'Moving': return 'badge-mov';
                case 'Idle': return 'badge-idle';
                case 'Offline':
                default:
                    return 'badge-off';
            }
        }

        // Fetch dashboard statistics and devices
        async function fetchDashboard() {
            if (isFetchingDashboard) return;
            isFetchingDashboard = true;

            try {
                const response = await fetch('/api/dashboard');
                if (!response.ok) {
                    throw new Error('Failed to fetch dashboard data');
                }
                const data = await response.json();
                
                // Update relative lastSystemUpdateTime globally
                window.lastSystemUpdateTime = Date.now();
                document.getElementById('last-updated-display').innerText = new Date().toLocaleTimeString();

                // Update summary counters directly from API summary
                document.getElementById('count-online').innerText = data.summary.onlineDevices;
                document.getElementById('count-offline').innerText = data.summary.offlineDevices;
                document.getElementById('count-moving').innerText = data.summary.movingDevices;
                document.getElementById('count-low-battery').innerText = data.summary.lowBatteryDevices;

                // Update Recent Alerts panel
                const alertsContainer = document.getElementById('recent-alerts-container');
                alertsContainer.innerHTML = '';
                if (!data.recentAlerts || data.recentAlerts.length === 0) {
                    alertsContainer.innerHTML = `
                        <div class="text-center text-muted py-5 fw-semibold" style="font-size: 1rem;">
                            No recent alerts
                        </div>
                    `;
                } else {
                    data.recentAlerts.forEach(alert => {
                        alertsContainer.innerHTML += `
                            <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                <div>
                                    <div class="fw-bold text-white" style="font-size: 0.9rem;">${alert.deviceName}</div>
                                    <div class="text-muted" style="font-size: 0.8rem;">${alert.alertType}</div>
                                </div>
                                <div class="font-monospace text-secondary" style="font-size: 0.8rem;">
                                    ${alert.relativeTime}
                                </div>
                            </div>
                        `;
                    });
                }

                // Populate devices table
                const tbody = document.getElementById('devices-tbody');
                tbody.innerHTML = '';

                if (!data.devices || data.devices.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="11" class="text-center text-muted py-5">
                                <div class="d-flex flex-column align-items-center gap-2">
                                    <i class="bi bi-broadcast fs-2 text-secondary"></i>
                                    <div class="fw-semibold">No Beacon Detected</div>
                                    <div class="small text-secondary">Please ensure your Access Points are online.</div>
                                </div>
                            </td>
                        </tr>
                    `;
                } else {
                    data.devices.forEach(device => {
                        const row = document.createElement('tr');
                        
                        // Row Highlighting/Dimming based on status
                        if (device.status === 'Online') {
                            row.className = 'row-online';
                        } else if (device.status === 'Moving') {
                            row.className = 'row-moving';
                        } else if (device.status === 'Offline') {
                            row.className = 'row-offline';
                        }

                        // Format Last Seen (Relative time)
                        const formattedTime = device.lastSeenFormatted;

                        // Compute Status details from API status
                        const badgeClass = getBadgeClass(device.status);

                        const scannerText = device.scannerId || '-';
                        const buildingText = device.building || '-';
                        const floorText = device.floor || '-';
                        const locationText = device.location || '-';

                        let distanceText = '-';
                        if (device.status !== 'Offline' && device.estimatedDistance !== null && device.estimatedDistance !== undefined) {
                            distanceText = device.estimatedDistance.toFixed(1) + ' m';
                        }

                        // Low Battery badge color helper
                        let batteryStyle = 'color: #10B981;';
                        if (device.batteryLevel < 20) {
                            batteryStyle = 'color: #ef4444; font-weight: bold;';
                        } else if (device.batteryLevel < 50) {
                            batteryStyle = 'color: #f59e0b;';
                        }

                        row.innerHTML = `
                            <td class="mac-addr">${device.macAddress}</td>
                            <td class="dev-name">${device.deviceName || '-'}</td>
                            <td>${scannerText}</td>
                            <td>${buildingText}</td>
                            <td>${floorText}</td>
                            <td>${locationText}</td>
                            <td class="rssi-value text-white">${device.rssi ? `${device.rssi} dBm` : '-'}</td>
                            <td>${distanceText}</td>
                            <td>
                                <span style="${batteryStyle} font-weight: 500;">${device.batteryLevel}%</span>
                            </td>
                            <td><span class="status-badge ${badgeClass}">${device.status}</span></td>
                            <td>${formattedTime}</td>
                        `;
                        tbody.appendChild(row);
                    });
                }

                // Update Chart.js components
                updateCharts(data.devices);

                // Transition out loading overlay
                const loader = document.getElementById('dashboard-loading-overlay');
                const content = document.getElementById('dashboard-main-content');
                if (loader && loader.style.display !== 'none') {
                    loader.style.opacity = '0';
                    setTimeout(() => {
                        loader.style.display = 'none';
                        content.style.opacity = '1';
                    }, 300);
                }

            } catch (err) {
                console.error('Error loading dashboard data:', err);
            } finally {
                isFetchingDashboard = false;
            }
        }

        // Initialize and update Chart.js
        function updateCharts(devices) {
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;

            // Add time label (Keep maximum 7 history elements)
            if (timeLabels.length >= 7) {
                timeLabels.shift();
            }
            timeLabels.push(timeStr);

            // Populate RSSI history for each device
            devices.forEach(device => {
                const key = device.macAddress;
                if (!rssiHistory[key]) {
                    rssiHistory[key] = [];
                }
                if (rssiHistory[key].length >= 7) {
                    rssiHistory[key].shift();
                }
                if (device.status === 'Offline') {
                    rssiHistory[key].push(null);
                } else {
                    rssiHistory[key].push(device.rssi);
                }
            });

            // 1. Render/Update RSSI Chart
            if (!rssiChart) {
                const ctxRssi = document.getElementById('rssiChart').getContext('2d');
                const colors = ['#10b981', '#3b82f6', '#ef4444', '#f59e0b', '#6366f1'];
                
                rssiChart = new Chart(ctxRssi, {
                    type: 'line',
                    data: {
                        labels: timeLabels,
                        datasets: devices.map((d, index) => ({
                            label: d.deviceName || d.macAddress,
                            data: rssiHistory[d.macAddress],
                            borderColor: colors[index % colors.length],
                            borderWidth: 2,
                            tension: 0.3,
                            fill: false
                        }))
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { boxWidth: 10, font: { family: 'Outfit', size: 11 } }
                            }
                        },
                        scales: {
                            y: {
                                min: -100,
                                max: -30,
                                title: { display: true, text: 'RSSI (dBm)', font: { family: 'Outfit', size: 11 } }
                            },
                            x: {
                                ticks: { font: { family: 'Outfit', size: 10 } }
                            }
                        }
                    }
                });
            } else {
                rssiChart.data.labels = timeLabels;
                const colors = ['#10b981', '#3b82f6', '#ef4444', '#f59e0b', '#6366f1'];
                rssiChart.data.datasets = devices.map((d, index) => ({
                    label: d.deviceName || d.macAddress,
                    data: rssiHistory[d.macAddress] || [],
                    borderColor: colors[index % colors.length],
                    borderWidth: 2,
                    tension: 0.3,
                    fill: false
                }));
                rssiChart.update();
            }
        }

        let signalRConnection = null;
        function initSignalR() {
            if (typeof signalR === "undefined") return;
            signalRConnection = new signalR.HubConnectionBuilder()
                .withUrl("/beaconHub")
                .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                .build();

            signalRConnection.on("BeaconUpdate", (data) => {
                if (!data) return;
                const t8 = new Date(); // T8: Browser received update
                
                if (data.macAddress && data.macAddress.startsWith("00:11:22:33:44")) return;

                if (data.t1_observedAt && data.t7_signalrBroadcast) {
                    const obsTime = new Date(data.t1_observedAt);
                    const broadcastTime = new Date(data.t7_signalrBroadcast);
                    const totalEndToEndMs = t8 - obsTime;
                    const networkBroadcastMs = t8 - broadcastTime;
                    console.log(`[DIAGNOSTICS T1->T8] Device: ${data.deviceName} (${data.macAddress}) | End-to-End Latency: ${totalEndToEndMs}ms | SignalR Transit: ${networkBroadcastMs}ms | Selected AP: ${data.scannerId}`);
                }

                // Immediately update dashboard view on real-time update
                fetchDashboard().then(() => {
                    const t9 = new Date(); // T9: UI finished rendering
                    if (data.t1_observedAt) {
                        const totalUiMs = t9 - new Date(data.t1_observedAt);
                        console.log(`[DIAGNOSTICS T1->T9] Full End-to-End Latency to UI Render: ${totalUiMs}ms`);
                    }
                });
            });

            signalRConnection.start().catch(err => console.error("SignalR Connection Error:", err));
        }

        // Perform initial fetch on page load
        document.addEventListener('DOMContentLoaded', () => {
            // Clock Logic
            function updateClock() {
                const el = document.getElementById('current-time-display');
                if (el) {
                    el.textContent = new Date().toLocaleTimeString();
                }
            }
            updateClock();
            setInterval(updateClock, 2000);

            fetchDashboard().then(() => {
                initSignalR();
            });

            // Polling loop as fallback (1.5 seconds)
            setInterval(fetchDashboard, 1500);
        });
    </script>
}
