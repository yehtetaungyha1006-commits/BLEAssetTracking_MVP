@model IEnumerable<Building>
@{
    ViewData["Title"] = "Building Management";
    var scannerCounts = ViewBag.ScannerCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    bool showInactive = ViewBag.ShowInactive ?? false;
}

<style>
    .beacons-header h2 {
        font-weight: 700;
        font-size: 1.75rem;
        background: linear-gradient(to right, #ffffff, #cbd5e1) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
    }

    .building-name {
        font-weight: 600;
        color: #ffffff;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .badge-online-custom {
        background-color: rgba(16, 185, 129, 0.12) !important;
        color: #34d399 !important;
        border: 1px solid rgba(16, 185, 129, 0.2) !important;
    }

    .badge-offline-custom {
        background-color: rgba(239, 68, 68, 0.12) !important;
        color: #f87171 !important;
        border: 1px solid rgba(239, 68, 68, 0.2) !important;
    }
</style>

<div class="scanners-container container-fluid page-shell">
    <!-- Success / Error Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-3 shadow-sm rounded-3 d-flex align-items-center p-3 flex-shrink-0" style="background-color: rgba(16, 185, 129, 0.15); border-left: 4px solid #10b981 !important;">
            <i class="bi bi-check-circle-fill text-success me-3 fs-5"></i>
            <div class="text-white">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-3 shadow-sm rounded-3 d-flex align-items-center p-3 flex-shrink-0" style="background-color: rgba(239, 68, 68, 0.15); border-left: 4px solid #ef4444 !important;">
            <i class="bi bi-exclamation-triangle-fill text-danger me-3 fs-5"></i>
            <div class="text-white">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="beacons-header page-header mb-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 0.85rem;">
                <a href="/FloorMap" class="text-decoration-none text-muted"><i class="bi bi-map me-1"></i>Floor Map</a>
                <span class="text-muted">/</span>
                <span class="text-white fw-semibold">Buildings</span>
            </div>
            <h2>Building Management</h2>
            <p class="text-muted mb-0">Manage buildings used by Floor Map and Access Points.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/FloorMap" class="btn btn-outline-light d-inline-flex align-items-center gap-2 px-3 py-2">
                <i class="bi bi-arrow-left"></i> Back to Floor Map
            </a>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2">
                <i class="bi bi-plus-circle"></i> Add Building
            </a>
        </div>
    </div>

    <!-- Search Input & Inactive Toggle -->
    <div class="page-toolbar d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
        <div class="position-relative" style="max-width: 380px; flex-grow: 1;">
            <input type="text" id="building-search-input" class="form-control input-custom" placeholder="Search Building..." />
            <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted" style="pointer-events: none;"></i>
        </div>
        <div>
            @if (showInactive)
            {
                <a href="/Buildings" class="btn btn-sm btn-outline-secondary">Hide Inactive Buildings</a>
            }
            else
            {
                <a href="/Buildings?showInactive=true" class="btn btn-sm btn-outline-secondary">Show Inactive Buildings</a>
            }
        </div>
    </div>

    <div class="card card-custom table-card">
        <div class="table-responsive table-scroll">
            <table class="table table-custom" id="buildings-table">
                <thead>
                    <tr>
                        <th>Building Name</th>
                        <th>Description</th>
                        <th>Floors</th>
                        <th>Access Points</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="mb-3 d-block mx-auto text-secondary">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                                </svg>
                                No buildings registered in the system.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var building in Model)
                        {
                            int activeFloors = building.Floors?.Count(f => f.IsActive) ?? 0;
                            int apCount = scannerCounts.ContainsKey(building.BuildingId) ? scannerCounts[building.BuildingId] : 0;
                            string badgeClass = building.IsActive ? "badge-on" : "badge-off";
                            string statusText = building.IsActive ? "Active" : "Inactive";

                            <tr>
                                <td class="building-name">@building.BuildingName</td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(building.Description) ? "-" : building.Description)</td>
                                <td><span class="badge bg-secondary bg-opacity-50 text-white font-monospace px-2 py-1">@activeFloors Floor(s)</span></td>
                                <td><span class="badge bg-primary bg-opacity-25 text-info font-monospace px-2 py-1">@apCount AP(s)</span></td>
                                <td>
                                    <span class="status-badge @badgeClass">
                                        @statusText
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@building.BuildingId" class="btn btn-outline-info btn-sm px-3" style="border-radius: 0.5rem; font-weight: 600;">
                                            Edit
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-sm px-3" style="border-radius: 0.5rem; font-weight: 600;" data-bs-toggle="modal" data-bs-target="#deleteBuildingModal-@building.BuildingId">
                                            Delete
                                        </button>
                                    </div>

                                    <!-- Styled Delete Confirmation Modal -->
                                    <div class="modal fade text-start" id="deleteBuildingModal-@building.BuildingId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content" style="background-color: #151f32; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 12px; color: #ffffff;">
                                                <div class="modal-header border-secondary">
                                                    <h5 class="modal-title text-danger fw-bold d-flex align-items-center gap-2">
                                                        <i class="bi bi-exclamation-triangle-fill"></i> Delete Building?
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-4">
                                                    <p class="mb-2">Are you sure you want to delete <strong>@building.BuildingName</strong>?</p>
                                                    @if (apCount > 0 || activeFloors > 0)
                                                    {
                                                        <div class="alert alert-warning border-0 small mt-3 mb-0" style="background-color: rgba(255, 193, 7, 0.15); color: #fbbf24;">
                                                            <i class="bi bi-info-circle me-1"></i> This building contains <strong>@activeFloors Floor(s)</strong> and <strong>@apCount Access Point(s)</strong>. If Access Points exist, deletion will be blocked until Access Points are reassigned.
                                                        </div>
                                                    }
                                                </div>
                                                <div class="modal-footer border-secondary">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@building.BuildingId" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-danger px-3 fw-semibold">
                                                            <i class="bi bi-trash me-1"></i> Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("building-search-input");
            const table = document.getElementById("buildings-table");
            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function (e) {
                const query = e.target.value.trim().toLowerCase();
                const rows = table.querySelectorAll("tbody tr");
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(query) ? "" : "none";
                });
            });
        });
    </script>
}
