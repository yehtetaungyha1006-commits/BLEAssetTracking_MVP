@model Building
@{
    ViewData["Title"] = "Delete Building";
    int scannerCount = ViewBag.ScannerCount ?? 0;
    int floorsCount = ViewBag.FloorsCount ?? 0;
    bool isReferenced = scannerCount > 0;
}

<style>
    .create-beacon-page {
        padding: 2rem 1rem;
        max-width: 540px;
        margin: 0 auto;
    }
    
    .beacon-title-container h2 {
        font-size: 1.75rem;
        font-weight: 700;
        background: linear-gradient(to right, #ffffff, #cbd5e1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.25rem;
    }

    .beacon-form-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
        overflow: hidden;
    }

    .beacon-form-body {
        padding: 1.5rem;
    }

    .label-custom {
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94a3b8;
        margin-bottom: 0.25rem;
        display: block;
    }

    .detail-val {
        color: #ffffff;
        font-weight: 500;
        font-size: 1rem;
    }

    .form-action-footer {
        background-color: rgba(0, 0, 0, 0.15);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .btn-delete-confirm {
        background: linear-gradient(135deg, #e11d48 0%, #f43f5e 100%);
        color: #ffffff !important;
        border: none;
        border-radius: 6px;
        padding: 0.5rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 38px;
    }

    .btn-cancel-custom {
        background-color: transparent;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        padding: 0.5rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 38px;
    }
</style>

<div class="create-beacon-page">
    <div class="beacon-title-container text-start mb-4">
        <h2>Delete Building</h2>
        <p class="text-muted">Confirm building deactivation/removal.</p>
    </div>

    @if (isReferenced)
    {
        <div class="alert alert-warning border-0 mb-4 shadow-sm rounded-3 d-flex align-items-center p-3" style="background-color: rgba(255, 193, 7, 0.12); border-left: 4px solid #ffc107 !important;">
            <i class="bi bi-exclamation-triangle-fill text-warning me-3 fs-4"></i>
            <div class="text-white">
                <strong>Cannot Delete:</strong> This building is currently referenced by <strong>@scannerCount Access Point(s)</strong> and <strong>@floorsCount floor(s)</strong>. Please reassign those Access Points first.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger border-0 mb-4 shadow-sm rounded-3 d-flex align-items-center p-3" style="background-color: rgba(239, 68, 68, 0.12); border-left: 4px solid #ef4444 !important;">
            <i class="bi bi-exclamation-octagon-fill text-danger me-3 fs-4"></i>
            <div class="text-white">
                Are you sure you want to deactivate or remove <strong>@Model.BuildingName</strong>?
            </div>
        </div>
    }

    <div class="beacon-form-card">
        <div class="beacon-form-body">
            <div class="mb-3">
                <span class="label-custom">Building Name</span>
                <div class="detail-val">@Model.BuildingName</div>
            </div>
            <div class="mb-3">
                <span class="label-custom">Description</span>
                <div class="detail-val">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</div>
            </div>
            <div class="mb-3">
                <span class="label-custom">Floors Assigned</span>
                <div class="detail-val font-monospace">@floorsCount Floor(s)</div>
            </div>
            <div class="mb-3">
                <span class="label-custom">Access Points Assigned</span>
                <div class="detail-val font-monospace">@scannerCount AP(s)</div>
            </div>
        </div>

        <div class="form-action-footer">
            <a asp-action="Index" class="btn-cancel-custom">Cancel</a>
            @if (!isReferenced)
            {
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="BuildingId" />
                    <button type="submit" class="btn-delete-confirm">Delete Building</button>
                </form>
            }
        </div>
    </div>
</div>
