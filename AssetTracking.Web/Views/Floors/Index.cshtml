@model IEnumerable<Floor>
@{
    ViewData["Title"] = "Floor Management";
    var buildings = ViewBag.Buildings as List<Building> ?? new List<Building>();
    int selectedBuildingId = ViewBag.SelectedBuildingId ?? 0;
    var scannerCounts = ViewBag.ScannerCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<style>
    .beacons-header h2 {
        font-weight: 700;
        font-size: 1.75rem;
        background: linear-gradient(to right, #ffffff, #cbd5e1) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
    }

    .floor-name {
        font-weight: 600;
        color: #ffffff;
    }

    .badge-map-available {
        background-color: rgba(16, 185, 129, 0.12) !important;
        color: #34d399 !important;
        border: 1px solid rgba(16, 185, 129, 0.2) !important;
    }

    .badge-map-missing {
        background-color: rgba(245, 158, 11, 0.12) !important;
        color: #fbbf24 !important;
        border: 1px solid rgba(245, 158, 11, 0.2) !important;
    }
</style>

<div class="scanners-container container-fluid page-shell">
    <!-- Success / Error Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-3 shadow-sm rounded-3 d-flex align-items-center p-3 flex-shrink-0" style="background-color: rgba(16, 185, 129, 0.15); border-left: 4px solid #10b981 !important;">
            <i class="bi bi-check-circle-fill text-success me-3 fs-5"></i>
            <div class="text-white">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-3 shadow-sm rounded-3 d-flex align-items-center p-3 flex-shrink-0" style="background-color: rgba(239, 68, 68, 0.15); border-left: 4px solid #ef4444 !important;">
            <i class="bi bi-exclamation-octagon-fill text-danger me-3 fs-5"></i>
            <div class="text-white">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="beacons-header page-header mb-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 0.85rem;">
                <a href="/FloorMap" class="text-decoration-none text-muted"><i class="bi bi-map me-1"></i>Floor Map</a>
                <span class="text-muted">/</span>
                <span class="text-white fw-semibold">Floors</span>
            </div>
            <h2>Floor Management</h2>
            <p class="text-muted mb-0">จัดการข้อมูลของชั้นอาคาร</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/FloorMap" class="btn btn-outline-light d-inline-flex align-items-center gap-2 px-3 py-2">
                <i class="bi bi-arrow-left"></i> Back to Floor Map
            </a>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2">
                <i class="bi bi-plus-circle"></i> Add Floor
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="page-toolbar d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
        <div class="d-flex align-items-center gap-3 flex-wrap flex-grow-1">
            <div style="min-width: 220px;">
                <select id="building-filter-select" class="form-select input-custom">
                    <option value="0">All Buildings</option>
                    @foreach (var b in buildings)
                    {
                        if (b.BuildingId == selectedBuildingId)
                        {
                            <option value="@b.BuildingId" selected>@b.BuildingName</option>
                        }
                        else
                        {
                            <option value="@b.BuildingId">@b.BuildingName</option>
                        }
                    }
                </select>
            </div>

            <div class="position-relative" style="max-width: 320px; flex-grow: 1;">
                <input type="text" id="floor-search-input" class="form-control input-custom" placeholder="Search Floor..." />
                <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted" style="pointer-events: none;"></i>
            </div>
        </div>
    </div>

    <div class="card card-custom table-card">
        <div class="table-responsive table-scroll">
            <table class="table table-custom" id="floors-table">
                <thead>
                    <tr>
                        <th>Floor Name</th>
                        <th>Building</th>
                        <th>Floor Map</th>
                        <th>Access Points</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="mb-3 d-block mx-auto text-secondary">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                                </svg>
                                No floors registered in the system.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var floor in Model)
                        {
                            bool hasMap = !string.IsNullOrWhiteSpace(floor.FloorMapImagePath);
                            int apCount = scannerCounts.ContainsKey(floor.FloorId) ? scannerCounts[floor.FloorId] : 0;

                            <tr>
                                <td class="floor-name">@floor.FloorName</td>
                                <td><span class="text-info fw-semibold">@(floor.Building?.BuildingName ?? "Unknown Building")</span></td>
                                <td>
                                    @if (hasMap)
                                    {
                                        <span class="status-badge badge-map-available">
                                            <i class="bi bi-image me-1"></i> Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-map-missing">
                                            <i class="bi bi-exclamation-circle me-1"></i> No Map
                                        </span>
                                    }
                                </td>
                                <td><span class="badge bg-primary bg-opacity-25 text-info font-monospace px-2 py-1">@apCount AP(s)</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@floor.FloorId" class="btn btn-outline-info btn-sm px-3" style="border-radius: 0.5rem; font-weight: 600;">
                                            Edit
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-sm px-3" style="border-radius: 0.5rem; font-weight: 600;" data-bs-toggle="modal" data-bs-target="#deleteFloorModal-@floor.FloorId">
                                            Delete
                                        </button>
                                    </div>

                                    <!-- Styled Delete Confirmation Modal -->
                                    <div class="modal fade text-start" id="deleteFloorModal-@floor.FloorId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content" style="background-color: #151f32; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 12px; color: #ffffff;">
                                                <div class="modal-header border-secondary">
                                                    <h5 class="modal-title text-danger fw-bold d-flex align-items-center gap-2">
                                                        <i class="bi bi-exclamation-triangle-fill"></i> Delete Floor?
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-4">
                                                    <p class="mb-2">Are you sure you want to delete <strong>@floor.FloorName</strong> (@(floor.Building?.BuildingName ?? "Building"))?</p>
                                                    @if (apCount > 0)
                                                    {
                                                        <div class="alert alert-warning border-0 small mt-3 mb-0" style="background-color: rgba(255, 193, 7, 0.15); color: #fbbf24;">
                                                            <i class="bi bi-info-circle me-1"></i> This floor is currently assigned to <strong>@apCount Access Point(s)</strong>. Deletion will be blocked until Access Points are reassigned.
                                                        </div>
                                                    }
                                                </div>
                                                <div class="modal-footer border-secondary">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@floor.FloorId" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-danger px-3 fw-semibold">
                                                            <i class="bi bi-trash me-1"></i> Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const bSelect = document.getElementById("building-filter-select");
            const searchInput = document.getElementById("floor-search-input");
            const table = document.getElementById("floors-table");

            if (bSelect) {
                bSelect.addEventListener("change", function () {
                    const bId = bSelect.value;
                    window.location.href = "/Floors?buildingId=" + bId;
                });
            }

            if (searchInput && table) {
                searchInput.addEventListener("input", function (e) {
                    const query = e.target.value.trim().toLowerCase();
                    const rows = table.querySelectorAll("tbody tr");
                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(query) ? "" : "none";
                    });
                });
            }
        });
    </script>
}
