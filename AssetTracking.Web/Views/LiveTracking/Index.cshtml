    .signal-fair .signal-bar:nth-child(2) { background-color: #f59e0b; }
    .signal-poor .signal-bar:nth-child(1) { background-color: #ef4444; }*/

    /* Battery styles */
    /*.battery-container {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 500;
    }*/

    .battery-icon {
        font-size: 1.1rem;
    }

    .battery-high { color: #10b981; }
    .battery-medium { color: #f59e0b; }
    .battery-low { color: #ef4444; }

    /* Row highlight animation */
    @@keyframes rowUpdateFlash {
        0% { background-color: rgba(99, 102, 241, 0.2); }
        100% { background-color: transparent; }
    }

    .row-update-flash {
        animation: rowUpdateFlash 0.8s ease-out;
    }
</style>

<div class="container-fluid page-shell">
    <div class="live-header page-header mb-3">
        <h2>Live Beacon Tracking</h2>
        <p class="text-muted mb-0">หน้าแสดงข้อมูลของ BLE beacons และ Access Point แบบ Real-time แบบละเอียด</p>
    </div>

    <!-- Metrics Cards -->
    <div class="metrics-grid-live flex-shrink-0 mb-3">
        <div class="metric-card-live">
            <div class="metric-icon-live metric-icon-total">
                <i class="bi bi-broadcast"></i>
            </div>
            <div>
                <div class="metric-value-live" id="totalBeaconsCount">0</div>
                <div class="metric-label-live">Total Beacons</div>
            </div>
        </div>
        <div class="metric-card-live">
            <div class="metric-icon-live metric-icon-online">
                <i class="bi bi-wifi"></i>
            </div>
            <div>
                <div class="metric-value-live" id="onlineBeaconsCount">0</div>
                <div class="metric-label-live">Online (Seen &le; 30s)</div>
            </div>
        </div>
        <div class="metric-card-live">
            <div class="metric-icon-live metric-icon-offline">
                <i class="bi bi-wifi-off"></i>
            </div>
            <div>
                <div class="metric-value-live" id="offlineBeaconsCount">0</div>
                <div class="metric-label-live">Offline (Inactive)</div>
            </div>
        </div>
    </div>

    <!-- Live Tracking Table -->
    <div class="card card-custom table-card">
        <div class="table-responsive table-scroll">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Device Name</th>
                        <th>MAC Address</th>
                        <th>Status</th>
                        <th>Access Point</th>
                        <th>Building</th>
                        <th>Floor</th>
                        <th>Location</th>
                        <th>RSSI</th>
                        <th>Distance</th>
                        <th>Battery</th>
                        <th>Last Seen</th>
                    </tr>
                </thead>
                <tbody id="liveTrackingBody">
                    <tr>
                        <td colspan="11" class="text-center py-5 text-muted">
                            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                            <span class="d-block">Loading real-time beacon metrics...</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-3 text-muted" style="font-size: 0.85rem;">
        Distance is estimated from BLE RSSI and may vary due to walls, people, equipment, and signal interference.
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const trackingBody = document.getElementById('liveTrackingBody');
        const totalBeaconsCount = document.getElementById('totalBeaconsCount');
        const onlineBeaconsCount = document.getElementById('onlineBeaconsCount');
        const offlineBeaconsCount = document.getElementById('offlineBeaconsCount');

        let deviceDataStore = {};

        function getBatteryMarkup(battery) {
            return `<span style="color: #10B981; font-weight: 500;">${battery}%</span>`;
        }

        function getRssiMarkup(rssi) {
            if (rssi === 0) return `<span class="text-muted">-</span>`;
            return `<span class="text-white">${rssi} dBm</span>`;
        }

        function estimateDistanceMeters(rssi) {
            if (!rssi) return null;
            const txPower = -59.0;
            const pathLossExponent = 2.5;
            const distance = Math.pow(10, (txPower - rssi) / (10.0 * pathLossExponent));
            return Math.round(distance * 10) / 10;
        }

        function getRelativeTimeStr(lastSeen) {
            if (!lastSeen) return 'Never';
            
            let lastSeenDate;
            if (lastSeen instanceof Date) {
                lastSeenDate = lastSeen;
            } else {
                let dateStr = String(lastSeen).replace(' ', 'T');
                if (!dateStr.endsWith('Z') && !dateStr.includes('+')) {
                    dateStr += 'Z';
                }
                lastSeenDate = new Date(dateStr);
            }

            if (isNaN(lastSeenDate.getTime())) return 'Never';
            
            const now = new Date();
            const diffMs = now - lastSeenDate;
            const diffSecs = Math.max(0, Math.floor(diffMs / 1000));
            
            if (diffSecs < 10) {
                return 'just now';
            } else if (diffSecs < 60) {
                return `${diffSecs} sec ago`;
            } else if (diffSecs < 3600) {
                const diffMins = Math.floor(diffSecs / 60);
                return `${diffMins} min ago`;
            } else if (diffSecs < 86400) {
                const diffHrs = Math.floor(diffSecs / 3600);
                return `${diffHrs} hr ago`;
            } else if (diffSecs < 604800) {
                const diffDays = Math.floor(diffSecs / 86400);
                return `${diffDays} days ago`;
            } else {
                const yyyy = lastSeenDate.getFullYear();
                const MM = String(lastSeenDate.getMonth() + 1).padStart(2, '0');
                const dd = String(lastSeenDate.getDate()).padStart(2, '0');
                const HH = String(lastSeenDate.getHours()).padStart(2, '0');
                const mm = String(lastSeenDate.getMinutes()).padStart(2, '0');
                return `${yyyy}-${MM}-${dd} ${HH}:${mm}`;
            }
        }

        function renderRowHtml(beacon) {
            const isOnline = beacon.status.toLowerCase() === 'online' || beacon.status.toLowerCase() === 'moving';
            const statusClass = beacon.status === 'Online' ? 'badge-on' : (beacon.status === 'Moving' ? 'badge-mov' : 'badge-off');

            let distanceText = "-";
            if (isOnline && beacon.estimatedDistance !== null && beacon.estimatedDistance !== undefined) {
                distanceText = beacon.estimatedDistance.toFixed(1) + " m";
            }

            // Low Battery badge color helper
            let batteryStyle = 'color: #10B981;';
            if (beacon.battery < 20) {
                batteryStyle = 'color: #ef4444; font-weight: bold;';
            } else if (beacon.battery < 50) {
                batteryStyle = 'color: #f59e0b;';
            }

            return `
                <td class="device-name">${beacon.deviceName}</td>
                <td class="mac-address">${beacon.macAddress}</td>
                <td>
                    <span class="status-badge ${statusClass}">
                        ${beacon.status}
                    </span>
                </td>
                <td class="text-white fw-semibold">${beacon.scannerId}</td>
                <td>${beacon.building}</td>
                <td>${beacon.floor}</td>
                <td>${beacon.location}</td>
                <td>${getRssiMarkup(beacon.rssi)}</td>
                <td>${distanceText}</td>
                <td>
                    <span style="${batteryStyle} font-weight: 500;">${beacon.battery}%</span>
                </td>
                <td class="font-monospace text-secondary">${beacon.lastSeen}</td>
            `;
        }

        function updateMetricsCounts() {
            let onlineCount = 0;
            let offlineCount = 0;
            let totalCount = 0;

            const now = new Date();

            Object.keys(deviceDataStore).forEach(key => {
                const beacon = deviceDataStore[key];
                totalCount++;

                let isOnline = false;
                if (beacon.rawLastSeen) {
                    const lastSeenDate = new Date(beacon.rawLastSeen);
                    const diffMs = now - lastSeenDate;
                    const diffSecs = Math.max(0, Math.floor(diffMs / 1000));
                    isOnline = diffSecs <= 30;
                }

                if (isOnline) {
                    onlineCount++;
                } else {
                    offlineCount++;
                }
            });

            totalBeaconsCount.innerText = totalCount;
            onlineBeaconsCount.innerText = onlineCount;
            offlineBeaconsCount.innerText = offlineCount;
        }

        function checkOfflineStatus() {
            let onlineCount = 0;
            let offlineCount = 0;
            let totalCount = 0;

            const now = new Date();

            Object.keys(deviceDataStore).forEach(key => {
                const beacon = deviceDataStore[key];
                totalCount++;

                let isOnline = false;
                if (beacon.rawLastSeen) {
                    const lastSeenDate = new Date(beacon.rawLastSeen);
                    const diffMs = now - lastSeenDate;
                    const diffSecs = Math.max(0, Math.floor(diffMs / 1000));
                    isOnline = diffSecs <= 30;
                }

                const currentStatus = isOnline ? 'Online' : 'Offline';

                if (isOnline) {
                    onlineCount++;
                } else {
                    offlineCount++;
                }

                if (beacon.status !== currentStatus) {
                    beacon.status = currentStatus;
                    beacon.lastSeen = getRelativeTimeStr(beacon.rawLastSeen);
                    
                    const macSafe = beacon.macAddress.replace(/:/g, '');
                    const row = document.getElementById(`row-${macSafe}`);
                    if (row) {
                        row.className = isOnline ? 'row-online' : 'row-offline';
                        row.innerHTML = renderRowHtml(beacon);
                    }
                } else {
                    const macSafe = beacon.macAddress.replace(/:/g, '');
                    const row = document.getElementById(`row-${macSafe}`);
                    if (row) {
                        const lastSeenCell = row.querySelector('td:last-child');
                        if (lastSeenCell) {
                            lastSeenCell.innerText = getRelativeTimeStr(beacon.rawLastSeen);
                        }

                        // Sync row class just in case
                        row.className = isOnline ? (beacon.isMoving ? 'row-moving' : 'row-online') : 'row-offline';

                        if (!isOnline) {
                            const distanceCell = row.querySelector('td:nth-child(9)');
                            if (distanceCell && distanceCell.innerText !== '-') {
                                distanceCell.innerText = '-';
                            }
                        }
                    }
                }
            });

            totalBeaconsCount.innerText = totalCount;
            onlineBeaconsCount.innerText = onlineCount;
            offlineBeaconsCount.innerText = offlineCount;
        }

        let isFetchInProgress = false;

        async function fetchLiveTracking() {
            if (isFetchInProgress) return;
            isFetchInProgress = true;

            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 5000);

            const startTime = performance.now();
            console.log(`[LiveTracking][REQUEST] URL: /LiveTracking/Data | Method: GET | StartedAt: ${new Date().toISOString()}`);

            try {
                const response = await fetch('/LiveTracking/Data', { signal: controller.signal });
                clearTimeout(timeoutId);

                const elapsedMs = Math.round(performance.now() - startTime);

                if (!response.ok) {
                    console.error(`[LiveTracking][ERROR] HTTP Status: ${response.status} | ElapsedMs: ${elapsedMs}ms`);
                    throw new Error(`HTTP Error ${response.status}`);
                }

                const data = await response.json();
                console.log(`[LiveTracking][RESPONSE] HTTP Status: 200 | ElapsedMs: ${elapsedMs}ms | BeaconCount: ${data.length}`);

                window.lastSystemUpdateTime = Date.now();

                let total = data.length;
                let online = 0;
                let offline = 0;

                let rowsHtml = '';
                deviceDataStore = {};

                data.forEach(beacon => {
                    const isOnline = beacon.status.toLowerCase() === 'online' || beacon.status.toLowerCase() === 'moving';
                    if (isOnline) online++; else offline++;

                    const key = beacon.macAddress;
                    deviceDataStore[key] = beacon;

                    const macSafe = key.replace(/:/g, '');
                    const rowClass = beacon.status === 'Online' ? 'row-online' : (beacon.status === 'Moving' ? 'row-moving' : 'row-offline');
                    rowsHtml += `<tr id="row-${macSafe}" class="${rowClass}">
                        ${renderRowHtml(beacon)}
                    </tr>`;
                });

                if (total === 0) {
                    rowsHtml = `<tr>
                        <td colspan="11" class="text-center py-5 text-muted">
                            <div class="d-flex flex-column align-items-center gap-2">
                                <i class="bi bi-broadcast fs-2 text-secondary"></i>
                                <div class="fw-semibold">No Beacon Registered</div>
                                <div class="small text-secondary">Please add registered Beacons to the system.</div>
                            </div>
                        </td>
                    </tr>`;
                }

                trackingBody.innerHTML = rowsHtml;
                totalBeaconsCount.innerText = total;
                onlineBeaconsCount.innerText = online;
                offlineBeaconsCount.innerText = offline;

            } catch (err) {
                clearTimeout(timeoutId);
                const elapsedMs = Math.round(performance.now() - startTime);
                console.error(`[LiveTracking][ERROR] Error: ${err.message} | ElapsedMs: ${elapsedMs}ms`);

                if (Object.keys(deviceDataStore).length === 0) {
                    trackingBody.innerHTML = `<tr>
                        <td colspan="11" class="text-center py-4 text-danger font-semibold">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Unable to load live tracking data. Retrying...
                        </td>
                    </tr>`;
                }
            } finally {
                isFetchInProgress = false;
            }
        }

        let signalRConnection = null;

        function initSignalR() {
            if (typeof signalR === "undefined") {
                console.warn("SignalR library not loaded");
                return;
            }

            signalRConnection = new signalR.HubConnectionBuilder()
                .withUrl("/beaconHub")
                .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                .build();

            const handleBeaconUpdate = (data) => {
                if (!data) return;
                const t8 = new Date(); // T8: Browser received update

                if (data.macAddress && data.macAddress.startsWith("00:11:22:33:44")) {
                    return;
                }

                const deviceId = data.deviceId || data.beaconId || (data.major && data.minor ? `${data.major}-${data.minor}` : data.macAddress);
                const key = String(deviceId);
                const receiveTime = data.receiveTime ? new Date(data.receiveTime) : new Date();

                const prevData = deviceDataStore[key];
                if (prevData && prevData.rawLastSeen) {
                    const prevTime = new Date(prevData.rawLastSeen);
                    if (receiveTime < prevTime) {
                        return; // Ignore stale out-of-order update
                    }
                }

                if (data.t1_observedAt) {
                    const obsTime = new Date(data.t1_observedAt);
                    const endToEndMs = t8 - obsTime;
                    console.log(`[LIVE TRACKING T1->T8] DeviceId: ${data.deviceId} (${data.deviceName}) | End-to-End Latency: ${endToEndMs}ms | Selected AP: ${data.scannerId}`);
                }

                // Reset global update timer
                window.lastSystemUpdateTime = Date.now();

                const now = new Date();

                const updatedBeacon = {
                    deviceId: data.deviceId,
                    deviceName: data.deviceName || "Unnamed Beacon",
                    macAddress: data.macAddress,
                    status: data.status || "Online",
                    isMoving: data.isMoving,
                    scannerId: data.scannerId || "-",
                    building: data.scannerBuilding || "-",
                    floor: data.scannerFloor || "-",
                    location: data.scannerLocation || "-",
                    rssi: data.rssi,
                    estimatedDistance: data.rssi ? estimateDistanceMeters(data.rssi) : null,
                    battery: data.batteryLevel,
                    lastSeen: "just now",
                    rawLastSeen: receiveTime.toISOString()
                };

                deviceDataStore[key] = updatedBeacon;

                const deviceIdSafe = key.replace(/[^a-zA-Z0-9_-]/g, '');
                const row = document.getElementById(`row-device-${deviceIdSafe}`) || document.getElementById(`row-${deviceIdSafe}`);
                const rowClass = updatedBeacon.status === "Offline" ? "row-offline" : (updatedBeacon.isMoving ? "row-moving" : "row-online");

                if (row) {
                    row.className = rowClass;
                    row.innerHTML = renderRowHtml(updatedBeacon);
                    if (!prevData || prevData.status !== updatedBeacon.status || prevData.rssi !== updatedBeacon.rssi || prevData.scannerId !== updatedBeacon.scannerId) {
                        row.classList.remove('row-update-flash');
                        void row.offsetWidth; // trigger reflow
                        row.classList.add('row-update-flash');
                    }
                } else {
                    // Check if we need to remove the empty state row
                    const emptyRow = trackingBody.querySelector('tr[id="empty-state-row"]') || trackingBody.querySelector('td[colspan="11"]')?.parentNode;
                    if (emptyRow && emptyRow.parentNode) {
                        emptyRow.parentNode.removeChild(emptyRow);
                    }

                    const newRow = document.createElement('tr');
                    newRow.id = `row-device-${deviceIdSafe}`;
                    newRow.setAttribute('data-device-id', deviceId);
                    newRow.className = rowClass;
                    newRow.innerHTML = renderRowHtml(updatedBeacon);
                    trackingBody.appendChild(newRow);
                }

                updateMetricsCounts();
            };

            signalRConnection.on("BeaconUpdate", handleBeaconUpdate);
            signalRConnection.on("TelemetryUpdated", handleBeaconUpdate);

            signalRConnection.start().catch(err => console.error("SignalR Connection Error:", err));
        }

        // Run initial REST fetch and start SignalR independently in parallel
        document.addEventListener('DOMContentLoaded', () => {
            fetchLiveTracking();
            initSignalR();
            setInterval(checkOfflineStatus, 5000);
        });
    </script>
}
