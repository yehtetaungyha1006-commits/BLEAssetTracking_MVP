@model AssetTracking.Web.ViewModels.FloorMapViewModel
@{
    ViewData["Title"] = "Floor Map";
    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
    var jsonData = System.Text.Json.JsonSerializer.Serialize(Model ?? new AssetTracking.Web.ViewModels.FloorMapViewModel(), jsonOptions);
}

<link rel="stylesheet" href="~/css/floormap.css" asp-append-version="true" />

<style>
    .beacons-header h2 {
        font-weight: 700;
        font-size: 1.5rem;
        background: linear-gradient(to right, #ffffff, #cbd5e1) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
    }

    .floormap-filter-bar {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.65rem 1rem;
        margin-bottom: 1rem;
    }
</style>

<script id="floorMapData" type="application/json">
    @Html.Raw(jsonData)
</script>

<div class="scanners-container container-fluid">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger bg-danger text-white border-0 mb-3 py-2 px-3 shadow-sm rounded-3 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
            <div class="small">@ViewBag.ErrorMessage</div>
        </div>
    }

    <!-- Toast Notification Container -->
    <div id="floormap-toast" class="toast align-items-center text-white bg-success border-0 position-fixed bottom-0 end-0 m-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="z-index: 1100;">
        <div class="d-flex">
            <div id="floormap-toast-body" class="toast-body fw-bold">
                Action completed successfully.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <!-- Unified Page Header -->
    <div class="beacons-header mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-0">Floor Map</h2>
            <p class="text-muted mb-0 small">Manage buildings, floors and monitor BLE assets by location.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- SignalR Connection Badge -->
            <div class="status-badge-custom py-1 me-1">
                <span id="floormap-signalr-status-dot" class="status-badge-dot connecting"></span>
                <span class="small">SignalR: <strong id="signalr-status-text" class="text-white">Connecting...</strong></span>
            </div>

            <!-- Primary Action Buttons -->
            <a href="/Buildings/Create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-3 py-1">
                <i class="bi bi-plus-circle"></i> Add Building
            </a>
            <a href="/Floors/Create" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-3 py-1">
                <i class="bi bi-plus-circle"></i> Add Floor
            </a>
            <a href="/Buildings" class="btn btn-outline-light btn-sm d-inline-flex align-items-center gap-1 px-3 py-1">
                <i class="bi bi-building"></i> Buildings
            </a>
            <a href="/Floors" class="btn btn-outline-light btn-sm d-inline-flex align-items-center gap-1 px-3 py-1">
                <i class="bi bi-layers"></i> Floors
            </a>
        </div>
    </div>

    <!-- Single Top Filter Toolbar -->
    <div class="floormap-filter-bar">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3 flex-wrap flex-grow-1">
                <!-- Building Selector -->
                <div class="d-flex align-items-center gap-2">
                    <label for="building-filter" class="label-custom m-0 text-nowrap small"><i class="bi bi-building me-1"></i>Building:</label>
                    <select id="building-filter" class="form-select input-custom py-1 text-sm" style="min-width: 160px;" aria-label="Building Filter">
                    </select>
                </div>

                <!-- Floor Selector -->
                <div class="d-flex align-items-center gap-2">
                    <label for="floor-filter" class="label-custom m-0 text-nowrap small"><i class="bi bi-layers me-1"></i>FloorName:</label>
                    <select id="floor-filter" class="form-select input-custom py-1 text-sm" style="min-width: 140px;" aria-label="Floor Filter">
                    </select>
                </div>

                <!-- Search Beacon -->
                <div class="position-relative flex-grow-1" style="max-width: 280px;">
                    <input type="text" id="beacon-search-input" class="form-control input-custom py-1 pe-4 text-sm" placeholder="Search Beacon..." aria-label="Search Beacon">
                    <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-2 text-muted" style="font-size: 0.8rem; pointer-events: none;"></i>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                <button id="btn-open-upload-map" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1" type="button" data-bs-toggle="modal" data-bs-target="#uploadFloorMapModal">
                    <i class="bi bi-upload"></i> Upload Map
                </button>

                <button id="btn-edit-mode" class="btn btn-outline-info btn-sm d-flex align-items-center gap-1" style="border-radius: 0.5rem; font-weight: 600;">
                    <i class="bi bi-pencil-square"></i> Edit AP Positions
                </button>
            </div>
        </div>
    </div>

    <!-- Admin Edit Mode Indicator Bar -->
    <div id="edit-mode-indicator" class="alert alert-info border-0 mb-3 shadow-sm rounded-3 d-none align-items-center justify-content-between p-2 px-3" style="background-color: rgba(13, 202, 240, 0.15); border-left: 4px solid #0dcaf0 !important;">
        <div class="d-flex align-items-center gap-2">
            <span class="spinner-grow spinner-grow-sm text-info flex-shrink-0" role="status" aria-hidden="true" style="animation-duration: 1.5s;"></span>
            <span class="text-white small"><strong>Admin Edit Mode Active</strong>: Drag the blue Access Point markers directly over the floor plan image to reposition them.</span>
        </div>
        <div id="edit-actions-container" class="d-flex align-items-center gap-2 flex-shrink-0">
            <button id="btn-save-positions" class="btn btn-sm btn-success px-3" style="border-radius: 0.5rem; font-weight: 500;">
                <i class="bi bi-check-lg"></i> Save
            </button>
            <button id="btn-cancel-positions" class="btn btn-sm btn-secondary px-3" style="border-radius: 0.5rem; font-weight: 500;">
                <i class="bi bi-x-lg"></i> Cancel
            </button>
        </div>
    </div>

    <!-- Unmapped Warnings Banner -->
    <div id="unmapped-warnings" class="alert alert-warning border-0 mb-3 shadow-sm rounded-3 d-none align-items-center p-2" style="background-color: rgba(255, 193, 7, 0.1); border-left: 4px solid #ffc107 !important;">
        <i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-6"></i>
        <div class="text-white small" id="unmapped-warnings-text"></div>
    </div>

    <!-- Main Content Layout Grid -->
    <div class="floor-map-main">
        <!-- LEFT PANEL: Beacon List -->
        <div class="beacon-list-card">
            <div class="floormap-panel-header mb-2 pb-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="floormap-panel-title fs-6 m-0">
                        <i class="bi bi-list-ul"></i> Beacon List
                    </h2>
                </div>
            </div>
            <div class="beacon-list-container flex-grow-1 overflow-y-auto" id="beacon-list-container" style="min-height: 440px; max-height: 560px;">
            </div>
        </div>

        <!-- RIGHT PANEL: Floor Plan Canvas -->
        <div class="floor-plan-card">
            <div class="floormap-panel-header mb-2 pb-2">
                <h2 class="floormap-panel-title fs-6 m-0" id="floor-map-title">
                    <i class="bi bi-map"></i> Floor Plan
                </h2>
                <div id="floor-map-meta" class="text-muted small">
                    <span id="selected-building-name" class="fw-semibold text-light">--</span> /
                    <span id="selected-floor-name" class="text-info fw-semibold">--</span>
                </div>
            </div>

            <!-- Interactive Map Canvas Container -->
            <div id="floor-map-wrapper" class="floor-map-wrapper flex-grow-1" style="min-height: 440px; position: relative;">
                <div id="floor-plan-stage" class="floor-plan-stage">
                    <!-- Base Uploaded Floor Plan Image -->
                    <img id="floorPlanImage" class="floor-plan-image d-none" src="#" alt="Floor Plan" />

                    <!-- Clean Empty State -->
                    <div id="floormap-no-image-state" class="floormap-empty-state d-none">
                        <i class="bi bi-image floormap-empty-icon"></i>
                        <h4 class="floormap-empty-title">No Floor Map Uploaded</h4>
                        <p class="floormap-empty-desc text-muted">Upload a floor map image to visualize Access Points and real-time Beacon locations.</p>
                    </div>

                    <!-- Absolute Marker Overlay Layer for APs & Beacons -->
                    <div id="mapMarkerLayer" class="map-marker-layer"></div>
                </div>
            </div>

            <!-- Legend Bar -->
            <div class="floormap-legend flex-shrink-0 mt-2">
                <div class="legend-item">
                    <span class="legend-badge scanner"></span>
                    <span class="small">Access Point</span>
                </div>
                <div class="legend-item">
                    <span class="legend-badge online-beacon"></span>
                    <span class="small">Active Beacon</span>
                </div>
                <div class="legend-item">
                    <span class="legend-badge offline-beacon"></span>
                    <span class="small">Offline Beacon</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Status Bar Footer -->
    <footer class="floormap-status-bar mt-3 py-2">
        <div class="status-bar-item">
            <i class="bi bi-cpu text-primary"></i>
            <span class="status-bar-label">Access Points:</span>
            <span id="stat-scanners-count" class="status-bar-val">0</span>
        </div>
        <div class="status-bar-divider"></div>
        <div class="status-bar-item">
            <i class="bi bi-broadcast text-info"></i>
            <span class="status-bar-label">Beacons:</span>
            <span id="stat-beacons-count" class="status-bar-val">0</span>
        </div>
        <div class="status-bar-divider"></div>
        <div class="status-bar-item">
            <i class="bi bi-check-circle-fill text-success"></i>
            <span class="status-bar-label">Online:</span>
            <span id="stat-online-count" class="status-bar-val text-success">0</span>
        </div>
        <div class="status-bar-divider"></div>
        <div class="status-bar-item">
            <i class="bi bi-x-circle-fill text-danger"></i>
            <span class="status-bar-label">Offline:</span>
            <span id="stat-offline-count" class="status-bar-val text-danger">0</span>
        </div>
        <div class="status-bar-divider"></div>
        <div class="status-bar-item">
            <i class="bi bi-battery-charging text-warning"></i>
            <span class="status-bar-label">Low Battery:</span>
            <span id="stat-low-battery-count" class="status-bar-val text-warning">0</span>
        </div>
        <div class="status-bar-divider"></div>
        <div class="status-bar-item ms-auto">
            <i class="bi bi-clock-history text-muted"></i>
            <span class="status-bar-label">Last Update:</span>
            <span id="stat-last-update-time" class="status-bar-val text-muted">Just now</span>
        </div>
    </footer>
</div>

<!-- Upload Floor Map Modal -->
<div class="modal fade" id="uploadFloorMapModal" tabindex="-1" aria-labelledby="uploadFloorMapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg rounded-3">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold" id="uploadFloorMapModalLabel">
                    <i class="bi bi-upload me-2 text-primary"></i>Upload Floor Map Image
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="form-upload-floor-map" enctype="multipart/form-data">
                <div class="modal-body">
                    <div id="upload-map-error" class="alert alert-danger d-none py-2 px-3 small rounded-2 mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label text-light small fw-bold">Target Location</label>
                        <div id="upload-map-target-text" class="form-control-plaintext text-info fw-bold font-monospace bg-secondary bg-opacity-25 px-3 py-2 rounded-2">
                            Select a Floor...
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="floor-map-file-input" class="form-label text-light small fw-bold">Select Map Image File <span class="text-danger">*</span></label>
                        <input type="file" class="form-control bg-secondary text-white border-0" id="floor-map-file-input" accept=".png,.jpg,.jpeg,.webp,.svg,image/svg+xml" required>
                        <small class="text-muted d-block mt-1">Allowed formats: PNG, JPG, JPEG, WEBP, SVG. Max size: 10 MB.</small>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="btn-submit-upload-map" class="btn btn-sm btn-primary px-3">
                        <i class="bi bi-cloud-upload me-1"></i> Upload Image
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SignalR Client Script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/floormap.js" asp-append-version="true"></script>
}