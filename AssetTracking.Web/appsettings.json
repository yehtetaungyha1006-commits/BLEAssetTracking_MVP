{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=AssetTrackingDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ScannerSettings": {
    "TelemetryIntervalSeconds": 1,
    "OfflineTimeoutSeconds": 30,
    "MinimumRssi": -100,
    "EnableAutoRegistration": true
  },
  "IndoorLocationSettings": {
    "ObservationWindowSeconds": 2,
    "MinimumRssi": -95,
    "NormalSwitchMarginDb": 4,
    "NormalConfirmationCount": 2,
    "FastSwitchMarginDb": 12,
    "FastConfirmationCount": 1,
    "CurrentApStaleSeconds": 2,
    "EmaAlpha": 0.6
  }
}